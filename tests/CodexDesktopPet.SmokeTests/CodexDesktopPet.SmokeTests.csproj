<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodexDesktopPet\CodexDesktopPet.csproj" />
    <None Include="..\..\src\CodexDesktopPet\MainWindow.xaml"
          Link="MainWindow.xaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\plugins\codex-desktop-pet\hooks\hooks.json"
          Link="hooks.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\plugins\codex-desktop-pet\server\settings-server.ps1"
          Link="settings-server.ps1"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\plugins\codex-desktop-pet\scripts\start-pet.ps1"
          Link="start-pet.ps1"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\plugins\codex-desktop-pet\mcp.json"
          Link="mcp.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
