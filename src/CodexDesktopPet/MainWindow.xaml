<Window x:Class="CodexDesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 桌宠" Width="430" Height="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ShowActivated="False" ResizeMode="NoResize"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
    <Grid>
        <Border x:Name="AnswerPanel" Margin="12,10,12,138" Padding="16,13"
                CornerRadius="18" Background="{StaticResource PanelBrush}"
                BorderBrush="#4568E9FF" BorderThickness="1" Visibility="Visible">
            <Border.Effect>
                <DropShadowEffect Color="#00222C" BlurRadius="22" ShadowDepth="4" Opacity="0.65" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="C O D E X" Foreground="{StaticResource AccentBrush}"
                               FontWeight="Bold" FontSize="11" />
                    <Button DockPanel.Dock="Right" Content="×" Click="HideAnswer_Click"
                            Width="22" Height="22" Foreground="#AEB8C8" Background="Transparent"
                            BorderThickness="0" FontSize="17" Cursor="Hand" />
                </DockPanel>
                <ScrollViewer Grid.Row="1" Margin="0,9,0,8" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="AnswerText" Foreground="#F5F8FF" FontSize="14"
                               LineHeight="22" TextWrapping="Wrap"
                               Text="我已经就位。选中文字后按 Ctrl + Alt + Q，我会给出简要回答。" />
                </ScrollViewer>
                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DirectQuestionBox" Padding="8,5" FontSize="12"
                             ToolTip="直接提问，或在划词回答后继续追问"
                             KeyDown="DirectQuestion_KeyDown" />
                    <Button Grid.Column="1" Content="提问" Click="AskDirect_Click" Margin="7,0,0,0"
                            Padding="12,4" Cursor="Hand" />
                </Grid>
                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <Button Content="复制回答" Click="CopyAnswer_Click" Padding="10,4"
                            Foreground="#D9F8FF" Background="#253A465A" BorderBrush="#3F68E9FF"
                            BorderThickness="1" Cursor="Hand" />
                    <Button Content="Codex 用量" Click="ShowUsage_Click" Margin="7,0,0,0" Padding="10,4"
                            Foreground="#D9F8FF" Background="#253A465A" BorderBrush="#3F68E9FF"
                            BorderThickness="1" Cursor="Hand" />
                    <Button Content="清空上下文" Click="ClearContext_Click" Margin="7,0,0,0" Padding="10,4"
                            Foreground="#D9F8FF" Background="#253A465A" BorderBrush="#3F68E9FF"
                            BorderThickness="1" Cursor="Hand" />
                    <TextBlock x:Name="HintText" Margin="10,5,0,0" Foreground="#8591A5"
                               FontSize="11" Text="0 轮上下文" />
                </StackPanel>
            </Grid>
        </Border>

        <Canvas Height="150" Width="220" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,18,8">
            <Ellipse x:Name="GlowRing" Canvas.Left="64" Canvas.Top="5" Width="128" Height="128"
                     Stroke="#5968E9FF" StrokeThickness="3" Opacity="0.65">
                <Ellipse.Effect>
                    <BlurEffect Radius="11" />
                </Ellipse.Effect>
            </Ellipse>
            <Grid x:Name="PetBody" Canvas.Left="64" Canvas.Top="5" Width="128" Height="128"
                  RenderTransformOrigin="0.5,0.5" Cursor="Hand"
                  ToolTip="单击展开或收起回答；拖动可移动桌宠"
                  MouseLeftButtonDown="PetBody_MouseLeftButtonDown"
                  MouseLeftButtonUp="PetBody_MouseLeftButtonUp"
                  MouseMove="PetBody_MouseMove">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="直接提问" Click="FocusQuestion_Click" />
                        <MenuItem Header="查看 Codex 套餐额度" Click="ShowUsage_Click" />
                        <MenuItem Header="展开 / 收起回答" Click="ToggleAnswer_Click" />
                        <MenuItem Header="清空对话上下文" Click="ClearContext_Click" />
                        <MenuItem Header="设置…" Click="OpenSettings_Click" />
                        <Separator />
                        <MenuItem Header="退出桌宠" Click="ExitMenu_Click" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="PetTranslate" Y="0" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Image x:Name="PetImage" Width="128" Height="128" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" />
            </Grid>
            <Border Canvas.Left="0" Canvas.Top="92" Padding="10,6" CornerRadius="10"
                    Background="#DD1A1E29" BorderBrush="#3568E9FF" BorderThickness="1">
                <TextBlock x:Name="StatusText" Text="选中文字后按 Ctrl+Alt+Q"
                           Foreground="#DBE8F4" FontSize="11" />
            </Border>
        </Canvas>
    </Grid>
</Window>
