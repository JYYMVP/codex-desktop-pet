<Window x:Class="CodexDesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 桌宠" Width="370" Height="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#FF1F1F1F"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
    <Grid>
        <!-- 问答卡片与碎碎念气泡互相独立，避免两种内容混在一起。 -->
        <Border x:Name="AnswerPanel" Margin="16,10,16,174" Padding="16,14"
                MinHeight="104" MaxHeight="226" VerticalAlignment="Bottom"
                CornerRadius="18" Background="#FCFFFFFF"
                BorderBrush="#1F000000" BorderThickness="1" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#55000000" BlurRadius="24" ShadowDepth="7" Opacity="0.34" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#FF10A37F" Margin="0,0,8,0" />
                        <TextBlock Text="Codex" FontWeight="SemiBold" FontSize="13"
                                   Foreground="#FF1F1F1F" />
                        <TextBlock x:Name="HintText" Margin="8,1,0,0"
                                   Foreground="#FF7A7A7A" FontSize="11"
                                   Text="新宠物对话" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Content="×" Click="HideAnswer_Click"
                            Width="28" Height="28" Padding="0" FontSize="18"
                            Foreground="#FF555555" Background="Transparent"
                            BorderBrush="Transparent" />
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,11,0,9" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="AnswerText" FontSize="13.5" LineHeight="21"
                               Foreground="#FF1F1F1F" TextWrapping="Wrap" />
                </ScrollViewer>
                <Button Grid.Row="2" Content="复制回答" Click="CopyAnswer_Click"
                        HorizontalAlignment="Left" Padding="0,4" FontSize="11"
                        Foreground="#FF6C6C6C" Background="Transparent" BorderBrush="Transparent" />
            </Grid>
        </Border>

        <Grid x:Name="CommentBubble" HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Margin="38,0,38,174" MaxWidth="294" Visibility="Collapsed"
              Cursor="Hand" MouseLeftButtonDown="CommentBubble_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
            </Grid.RowDefinitions>
            <Border Padding="13,10" CornerRadius="16" Background="#FCFFFFFF"
                    BorderBrush="#1F000000" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#44000000" BlurRadius="20" ShadowDepth="5" Opacity="0.30" />
                </Border.Effect>
                <TextBlock x:Name="CommentText" FontSize="12" LineHeight="18"
                           Foreground="#FF252525" TextWrapping="Wrap" TextAlignment="Center" />
            </Border>
            <Path Grid.Row="1" HorizontalAlignment="Center" Margin="0,-1,0,0"
                  Data="M 0,0 L 12,0 L 6,7 Z" Fill="#FCFFFFFF"
                  Stroke="#1F000000" StrokeThickness="1" />
        </Grid>

        <!-- 官方 Pets 风格：宠物本体保持轻量，操作收进下方胶囊。 -->
        <Grid x:Name="PetBody" Width="104" Height="104"
              HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,62"
              RenderTransformOrigin="0.5,0.5" Cursor="Hand"
              ToolTip="单击：快速提问&#x0a;拖动：移动桌宠&#x0a;显示/隐藏：Ctrl+Alt+H"
              MouseLeftButtonDown="PetBody_MouseLeftButtonDown"
              MouseLeftButtonUp="PetBody_MouseLeftButtonUp"
              MouseMove="PetBody_MouseMove">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="直接提问" Click="FocusQuestion_Click" />
                    <MenuItem x:Name="PetOcrMenuItem" Header="OCR 框选识别（Ctrl+Alt+R）" Click="OcrRegion_Click" />
                    <MenuItem Header="查看 Codex 套餐额度" Click="ShowUsage_Click" />
                    <MenuItem Header="看一眼屏幕并吐槽" Click="LookAtScreen_Click" />
                    <MenuItem Header="展开 / 收起回答" Click="ToggleAnswer_Click" />
                    <MenuItem Header="在 Codex 中打开宠物对话" Click="OpenConversation_Click" />
                    <MenuItem Header="新建宠物对话" Click="ClearContext_Click" />
                    <MenuItem Header="宠物库…" Click="OpenPetLibrary_Click" />
                    <MenuItem Header="设置…" Click="OpenSettings_Click" />
                    <Separator />
                    <MenuItem x:Name="PetHideMenuItem" Header="隐藏桌宠（Ctrl+Alt+H）" Click="HidePet_Click" />
                    <MenuItem Header="退出桌宠" Click="ExitMenu_Click" />
                </ContextMenu>
            </Grid.ContextMenu>
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="PetTranslate" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Ellipse x:Name="GlowRing" Width="88" Height="88" HorizontalAlignment="Center"
                     VerticalAlignment="Center" Stroke="#2610A37F" StrokeThickness="2" Opacity="0.42">
                <Ellipse.Effect>
                    <BlurEffect Radius="12" />
                </Ellipse.Effect>
            </Ellipse>
            <Image x:Name="PetImage" Width="96" Height="96" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" />
        </Grid>

        <Border x:Name="StatusChip" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,111" Padding="10,5" CornerRadius="11"
                Background="#EFFFFFFF" BorderBrush="#18000000" BorderThickness="1"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="StatusText" Text="工作中…" FontSize="10.5"
                       Foreground="#FF555555" TextAlignment="Center" />
        </Border>

        <Border x:Name="ComposerPanel" Margin="22,0,22,70" Padding="7"
                VerticalAlignment="Bottom" CornerRadius="18" Background="#FCFFFFFF"
                BorderBrush="#24000000" BorderThickness="1" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#44000000" BlurRadius="20" ShadowDepth="5" Opacity="0.30" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DirectQuestionBox" Margin="2,0,7,0" Padding="9,7"
                         FontSize="12" VerticalContentAlignment="Center"
                         Foreground="#FF1F1F1F" Background="Transparent"
                         BorderBrush="Transparent" CaretBrush="#FF1F1F1F"
                         ToolTip="直接提问，或在划词回答后继续追问"
                         KeyDown="DirectQuestion_KeyDown" />
                <Button Grid.Column="1" Click="AskDirect_Click" Width="32" Height="32"
                        Padding="0" FontSize="17" ToolTip="发送"
                        Foreground="White" Background="#FF1F1F1F" BorderBrush="#FF1F1F1F">
                    <TextBlock Text="↑" Foreground="White" FontSize="17" />
                </Button>
            </Grid>
        </Border>

        <Border x:Name="ActionDock" Width="112" Height="44" Margin="0,0,0,16"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Background="#FCFFFFFF" BorderBrush="#20000000" BorderThickness="1"
                CornerRadius="22">
            <Border.Effect>
                <DropShadowEffect Color="#52000000" BlurRadius="18" ShadowDepth="5" Opacity="0.34" />
            </Border.Effect>
            <Grid Margin="7,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Click="FocusQuestion_Click" Padding="0" Background="Transparent"
                        BorderBrush="Transparent" ToolTip="快速提问">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE70F;"
                               FontSize="16" Foreground="#FF4B4B4B" />
                </Button>
                <Border Grid.Column="1" Width="1" Margin="0,5" Background="#18000000" />
                <Button Grid.Column="2" Click="LookAtScreen_Click" Padding="0"
                        Background="Transparent" BorderBrush="Transparent" ToolTip="看屏幕并吐槽">
                    <Grid Width="20" Height="18" VerticalAlignment="Center">
                        <Border Width="2" Height="7" CornerRadius="1" Background="#FF4B4B4B" HorizontalAlignment="Left" Margin="2,0,0,0" />
                        <Border Width="2" Height="13" CornerRadius="1" Background="#FF4B4B4B" HorizontalAlignment="Left" Margin="7,0,0,0" />
                        <Border Width="2" Height="17" CornerRadius="1" Background="#FF4B4B4B" HorizontalAlignment="Center" />
                        <Border Width="2" Height="11" CornerRadius="1" Background="#FF4B4B4B" HorizontalAlignment="Right" Margin="0,0,7,0" />
                        <Border Width="2" Height="6" CornerRadius="1" Background="#FF4B4B4B" HorizontalAlignment="Right" Margin="0,0,2,0" />
                    </Grid>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
