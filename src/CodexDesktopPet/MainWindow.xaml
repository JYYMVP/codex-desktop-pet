<Window x:Class="CodexDesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 桌宠" Width="420" Height="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
    <Grid>
        <!-- 回答只在真正有内容时出现，避免桌宠启动后占据大片桌面。 -->
        <Border x:Name="AnswerPanel" Margin="14,12,14,204" Padding="16,14"
                MinHeight="132" MaxHeight="290" VerticalAlignment="Bottom"
                CornerRadius="18" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.52" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="最近回答" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock x:Name="HintText" Margin="9,1,0,0"
                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="11"
                                   Text="新宠物对话" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Content="新对话" Click="ClearContext_Click" Padding="8,4"
                                Margin="0,0,4,0" FontSize="11" Background="Transparent"
                                Foreground="{StaticResource MutedTextBrush}" />
                        <Button Content="×" Click="HideAnswer_Click"
                                Style="{StaticResource IconButtonStyle}" Width="28" Height="28"
                                Foreground="{StaticResource MutedTextBrush}" ToolTip="收起回答" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,12,0,10" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="AnswerText" FontSize="14" LineHeight="21" TextWrapping="Wrap" />
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button Content="复制" Click="CopyAnswer_Click" Padding="9,5" FontSize="11"
                            Foreground="{StaticResource MutedTextBrush}" Background="Transparent" />
                    <Button Content="在 Codex 中继续" Click="OpenConversation_Click" Padding="9,5"
                            Margin="5,0,0,0" FontSize="11"
                            Foreground="{StaticResource MutedTextBrush}" Background="Transparent" />
                </StackPanel>
            </Grid>
        </Border>

        <Canvas Height="178" Width="214" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,68">
            <Ellipse x:Name="GlowRing" Canvas.Left="43" Canvas.Top="10" Width="128" Height="128"
                     Stroke="#3310A37F" StrokeThickness="2" Opacity="0.48">
                <Ellipse.Effect><BlurEffect Radius="15" /></Ellipse.Effect>
            </Ellipse>
            <Grid x:Name="PetBody" Canvas.Left="43" Canvas.Top="10" Width="128" Height="128"
                  RenderTransformOrigin="0.5,0.5" Cursor="Hand"
                  ToolTip="单击查看最近回答；拖动可移动桌宠"
                  MouseLeftButtonDown="PetBody_MouseLeftButtonDown"
                  MouseLeftButtonUp="PetBody_MouseLeftButtonUp"
                  MouseMove="PetBody_MouseMove">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="提问" Click="FocusQuestion_Click" />
                        <MenuItem x:Name="PetOcrMenuItem" Header="OCR 框选识别（Ctrl+Alt+R）" Click="OcrRegion_Click" />
                        <MenuItem Header="看一眼屏幕" Click="LookAtScreen_Click" />
                        <Separator />
                        <MenuItem Header="查看最近回答" Click="ToggleAnswer_Click" />
                        <MenuItem Header="在 Codex 中继续对话" Click="OpenConversation_Click" />
                        <MenuItem Header="新建宠物对话" Click="ClearContext_Click" />
                        <Separator />
                        <MenuItem Header="宠物库…" Click="OpenPetLibrary_Click" />
                        <MenuItem Header="设置…" Click="OpenSettings_Click" />
                        <MenuItem x:Name="PetHideMenuItem" Header="隐藏桌宠（Ctrl+Alt+H）" Click="HidePet_Click" />
                        <MenuItem Header="退出桌宠" Click="ExitMenu_Click" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="PetTranslate" Y="0" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Image x:Name="PetImage" Width="128" Height="128" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" />
            </Grid>
            <Border Canvas.Left="12" Canvas.Top="143" Width="190" Padding="11,6" CornerRadius="12"
                    Background="#E818181A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TextBlock x:Name="StatusText" Text="划词：Ctrl+Alt+Q"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Border>
        </Canvas>

        <Grid x:Name="CommentBubble" HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Margin="42,0,42,201" MaxWidth="310" Visibility="Collapsed"
              Cursor="Hand" MouseLeftButtonDown="CommentBubble_MouseLeftButtonDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
            </Grid.RowDefinitions>
            <Border Padding="13,10" CornerRadius="15" Background="#F51F1F22"
                    BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="5" Opacity="0.44" />
                </Border.Effect>
                <TextBlock x:Name="CommentText" FontSize="12" LineHeight="18"
                           TextWrapping="Wrap" TextAlignment="Center" />
            </Border>
            <Path Grid.Row="1" HorizontalAlignment="Center" Margin="0,-1,0,0"
                  Data="M 0,0 L 12,0 L 6,7 Z" Fill="#F51F1F22"
                  Stroke="{StaticResource StrongBorderBrush}" StrokeThickness="1" />
        </Grid>

        <!-- 高频动作固定在一行：OCR、输入、发送；其他能力收进“更多”。 -->
        <Border Height="58" Margin="14,0,14,12" VerticalAlignment="Bottom"
                Background="#F218181A" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="7" Opacity="0.48" />
            </Border.Effect>
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="框选" Click="OcrRegion_Click" Padding="10,0" Height="36"
                        FontSize="11" ToolTip="OCR 框选图片或扫描文档" />
                <Grid Grid.Column="1" Margin="6,0">
                    <TextBox x:Name="DirectQuestionBox" Padding="11,7" FontSize="12"
                             VerticalContentAlignment="Center" TextChanged="DirectQuestion_TextChanged"
                             ToolTip="输入问题；Enter 发送，Shift+Enter 换行"
                             KeyDown="DirectQuestion_KeyDown" />
                    <TextBlock x:Name="ComposerPlaceholder" Text="提问或继续追问…"
                               Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                </Grid>
                <Button x:Name="SendButton" Grid.Column="2" Click="AskDirect_Click"
                        Style="{StaticResource PrimaryButtonStyle}" Width="36" Height="36"
                        Padding="0" ToolTip="发送">
                    <TextBlock Text="↑" Foreground="#FF111113" FontSize="17" />
                </Button>
                <Button x:Name="CancelButton" Grid.Column="2" Click="CancelRequest_Click"
                        Width="36" Height="36" Padding="0" Visibility="Collapsed"
                        Foreground="{StaticResource DangerBrush}" ToolTip="停止当前操作">
                    <TextBlock Text="■" FontSize="11" />
                </Button>
                <Button x:Name="MoreButton" Grid.Column="3" Content="⋯" Margin="4,0,0,0"
                        Style="{StaticResource IconButtonStyle}" Click="MoreButton_Click" ToolTip="更多">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="查看最近回答" Click="ToggleAnswer_Click" />
                            <MenuItem Header="复制最近回答" Click="CopyAnswer_Click" />
                            <MenuItem Header="在 Codex 中继续对话" Click="OpenConversation_Click" />
                            <MenuItem Header="新建宠物对话" Click="ClearContext_Click" />
                            <Separator />
                            <MenuItem Header="看一眼屏幕" Click="LookAtScreen_Click" />
                            <MenuItem Header="查看 Codex 套餐额度" Click="ShowUsage_Click" />
                            <Separator />
                            <MenuItem Header="宠物库…" Click="OpenPetLibrary_Click" />
                            <MenuItem Header="设置…" Click="OpenSettings_Click" />
                            <MenuItem x:Name="MoreHideMenuItem" Header="隐藏桌宠（Ctrl+Alt+H）" Click="HidePet_Click" />
                            <MenuItem Header="退出" Click="ExitMenu_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
