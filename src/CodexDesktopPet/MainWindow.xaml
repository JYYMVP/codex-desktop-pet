<Window x:Class="CodexDesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 桌宠" Width="410" Height="500"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed">
    <Grid>
        <Border x:Name="AnswerPanel" Margin="12,10,12,196" Padding="18,15"
                MinHeight="118" MaxHeight="240" VerticalAlignment="Bottom"
                CornerRadius="16" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Visibility="Visible">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.52" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="Codex" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock x:Name="HintText" Margin="9,1,0,0"
                                   Foreground="{StaticResource SubtleTextBrush}" FontSize="11"
                                   Text="新宠物对话" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Content="×" Click="HideAnswer_Click"
                            Style="{StaticResource IconButtonStyle}" Width="28" Height="28"
                            Foreground="{StaticResource MutedTextBrush}" />
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,12,0,10" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="AnswerText" FontSize="14"
                               LineHeight="21" TextWrapping="Wrap"
                               Text="我已经就位。选中文字后按 Ctrl+Alt+Q，我会给出简要回答。" />
                </ScrollViewer>
                <Button Grid.Row="2" Content="复制回答" Click="CopyAnswer_Click"
                        HorizontalAlignment="Left" Padding="10,5" FontSize="11"
                        Foreground="{StaticResource MutedTextBrush}" Background="Transparent" />
            </Grid>
        </Border>

        <Canvas Height="184" Width="210" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,68">
            <Ellipse x:Name="GlowRing" Canvas.Left="41" Canvas.Top="17" Width="128" Height="128"
                     Stroke="#3310A37F" StrokeThickness="2" Opacity="0.48">
                <Ellipse.Effect>
                    <BlurEffect Radius="15" />
                </Ellipse.Effect>
            </Ellipse>
            <Grid x:Name="PetBody" Canvas.Left="41" Canvas.Top="17" Width="128" Height="128"
                  RenderTransformOrigin="0.5,0.5" Cursor="Hand"
                  ToolTip="单击展开或收起回答；拖动可移动桌宠"
                  MouseLeftButtonDown="PetBody_MouseLeftButtonDown"
                  MouseLeftButtonUp="PetBody_MouseLeftButtonUp"
                  MouseMove="PetBody_MouseMove">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="直接提问" Click="FocusQuestion_Click" />
                        <MenuItem Header="查看 Codex 套餐额度" Click="ShowUsage_Click" />
                        <MenuItem Header="看一眼屏幕并吐槽" Click="LookAtScreen_Click" />
                        <MenuItem Header="展开 / 收起回答" Click="ToggleAnswer_Click" />
                        <MenuItem Header="在 Codex 中打开宠物对话" Click="OpenConversation_Click" />
                        <MenuItem Header="新建宠物对话" Click="ClearContext_Click" />
                        <MenuItem Header="宠物库…" Click="OpenPetLibrary_Click" />
                        <MenuItem Header="设置…" Click="OpenSettings_Click" />
                        <Separator />
                        <MenuItem Header="退出桌宠" Click="ExitMenu_Click" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="PetTranslate" Y="0" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Image x:Name="PetImage" Width="128" Height="128" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" />
            </Grid>
            <Border Canvas.Left="20" Canvas.Top="148" Width="170" Padding="10,6" CornerRadius="12"
                    Background="#E818181A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TextBlock x:Name="StatusText" Text="选中文字后按 Ctrl+Alt+Q"
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Border>
        </Canvas>

        <Border Height="54" Margin="18,0,18,14" VerticalAlignment="Bottom"
                Background="#F218181A" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="7" Opacity="0.48" />
            </Border.Effect>
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="✎" Click="FocusQuestion_Click"
                        Style="{StaticResource IconButtonStyle}" ToolTip="快速提问" />
                <TextBox x:Name="DirectQuestionBox" Grid.Column="1" Margin="5,0,6,0"
                         Padding="11,7" FontSize="12" VerticalContentAlignment="Center"
                         ToolTip="直接提问，或在划词回答后继续追问"
                         KeyDown="DirectQuestion_KeyDown" />
                <Button Grid.Column="2" Click="AskDirect_Click"
                        Style="{StaticResource PrimaryButtonStyle}" Width="34" Height="34"
                        Padding="0" FontSize="17" ToolTip="发送">
                    <TextBlock Text="↑" Foreground="#FF111113" FontSize="17" />
                </Button>
                <Button x:Name="MoreButton" Grid.Column="3" Content="⋯" Margin="4,0,0,0"
                        Style="{StaticResource IconButtonStyle}" Click="MoreButton_Click"
                        ToolTip="更多">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="复制回答" Click="CopyAnswer_Click" />
                            <MenuItem Header="查看 Codex 套餐额度" Click="ShowUsage_Click" />
                            <MenuItem Header="看一眼屏幕并吐槽" Click="LookAtScreen_Click" />
                            <Separator />
                            <MenuItem Header="在 Codex 中打开宠物对话" Click="OpenConversation_Click" />
                            <MenuItem Header="新建宠物对话" Click="ClearContext_Click" />
                            <MenuItem Header="宠物库…" Click="OpenPetLibrary_Click" />
                            <MenuItem Header="设置…" Click="OpenSettings_Click" />
                            <Separator />
                            <MenuItem Header="隐藏桌宠" Click="HidePet_Click" />
                            <MenuItem Header="退出" Click="ExitMenu_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
