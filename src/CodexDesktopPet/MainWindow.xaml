<Window x:Class="CodexDesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex 桌宠" Width="430" Height="410"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" ShowActivated="False" ResizeMode="NoResize"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid>
        <Border x:Name="AnswerPanel" Margin="12,10,12,138" Padding="16,13"
                CornerRadius="18" Background="{StaticResource PanelBrush}"
                BorderBrush="#4568E9FF" BorderThickness="1" Visibility="Visible">
            <Border.Effect>
                <DropShadowEffect Color="#00222C" BlurRadius="22" ShadowDepth="4" Opacity="0.65" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="C O D E X" Foreground="{StaticResource AccentBrush}"
                               FontWeight="Bold" FontSize="11" />
                    <Button DockPanel.Dock="Right" Content="×" Click="HideAnswer_Click"
                            Width="22" Height="22" Foreground="#AEB8C8" Background="Transparent"
                            BorderThickness="0" FontSize="17" Cursor="Hand" />
                </DockPanel>
                <ScrollViewer Grid.Row="1" Margin="0,9,0,8" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="AnswerText" Foreground="#F5F8FF" FontSize="14"
                               LineHeight="22" TextWrapping="Wrap"
                               Text="我已经就位。选中文字后按 Ctrl + Alt + Q，我会给出简要回答。" />
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button Content="复制回答" Click="CopyAnswer_Click" Padding="10,4"
                            Foreground="#D9F8FF" Background="#253A465A" BorderBrush="#3F68E9FF"
                            BorderThickness="1" Cursor="Hand" />
                    <TextBlock x:Name="HintText" Margin="10,5,0,0" Foreground="#8591A5"
                               FontSize="11" Text="Ctrl + Alt + Q 再问一次" />
                </StackPanel>
            </Grid>
        </Border>

        <Canvas Height="142" Width="210" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,18,8">
            <Ellipse x:Name="GlowRing" Canvas.Left="69" Canvas.Top="12" Width="112" Height="112"
                     Stroke="#5968E9FF" StrokeThickness="3" Opacity="0.65">
                <Ellipse.Effect>
                    <BlurEffect Radius="11" />
                </Ellipse.Effect>
            </Ellipse>
            <Grid x:Name="PetBody" Canvas.Left="69" Canvas.Top="13" Width="112" Height="112"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="PetScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="PetTranslate" Y="0" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Ellipse Fill="#F4141925" Stroke="#B568E9FF" StrokeThickness="2" />
                <Ellipse Margin="12" Fill="#FF202838" Stroke="#405C718C" StrokeThickness="1" />
                <Path Data="M 28,29 C 39,13 73,13 84,29" Stroke="#7868E9FF"
                      StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse x:Name="LeftEye" Width="13" Height="17" Fill="#68E9FF"
                         HorizontalAlignment="Left" Margin="31,0,0,10" VerticalAlignment="Center" />
                <Ellipse x:Name="RightEye" Width="13" Height="17" Fill="#68E9FF"
                         HorizontalAlignment="Right" Margin="0,0,31,10" VerticalAlignment="Center" />
                <Path x:Name="Mouth" Data="M 42,73 Q 56,82 70,73" Stroke="#A8F5FF"
                      StrokeThickness="3" Fill="Transparent" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
                <Ellipse Width="5" Height="5" Fill="#FFFFFF" Opacity="0.9"
                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="37,42,0,0" />
                <Ellipse Width="5" Height="5" Fill="#FFFFFF" Opacity="0.9"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,42,37,0" />
            </Grid>
            <Path x:Name="Tail" Canvas.Left="170" Canvas.Top="80"
                  Data="M 0,0 C 30,-7 33,20 8,24" Stroke="#8B68E9FF" StrokeThickness="7"
                  Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <Border Canvas.Left="0" Canvas.Top="82" Padding="10,6" CornerRadius="10"
                    Background="#DD1A1E29" BorderBrush="#3568E9FF" BorderThickness="1">
                <TextBlock x:Name="StatusText" Text="选中文字后按 Ctrl+Alt+Q"
                           Foreground="#DBE8F4" FontSize="11" />
            </Border>
        </Canvas>
    </Grid>
</Window>
