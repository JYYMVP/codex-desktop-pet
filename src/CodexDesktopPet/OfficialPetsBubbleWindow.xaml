<Window x:Class="CodexDesktopPet.OfficialPetsBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="336" SizeToContent="Height" MaxHeight="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False">
    <Border Margin="12" Padding="16,13" CornerRadius="18"
            Background="{StaticResource RaisedPanelBrush}"
            BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1"
            Cursor="Hand" MouseLeftButtonDown="Bubble_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.22" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CommentText" TextWrapping="Wrap" FontSize="13"
                       LineHeight="19" Foreground="{StaticResource TextBrush}" MaxHeight="160" />
            <TextBlock Grid.Column="1" Text="×" Margin="12,-5,-4,0"
                       FontSize="18" Foreground="{StaticResource SubtleTextBrush}"
                       VerticalAlignment="Top" />
        </Grid>
    </Border>
</Window>
