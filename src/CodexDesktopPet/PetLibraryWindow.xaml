<Window x:Class="CodexDesktopPet.PetLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="宠物库" Width="760" Height="560" MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="宠物库" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="选择日常陪伴你的宠物，或导入自己的创作。"
                       Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <ListBox x:Name="PetList" Grid.Row="1" Margin="0,20,0,14" Padding="7"
                 SelectionChanged="PetList_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Margin="0,4,0,0"
                                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Id, StringFormat={}{0}}"
                                   Margin="18,2,4,0" Foreground="{StaticResource SubtleTextBrush}"
                                   FontSize="11" VerticalAlignment="Top" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Style="{StaticResource SectionCardStyle}" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="115" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="名称与描述" VerticalAlignment="Top" Margin="0,9,12,0"
                           Foreground="{StaticResource MutedTextBrush}" />
                <StackPanel Grid.Column="1">
                    <TextBox x:Name="NameBox" />
                    <TextBox x:Name="DescriptionBox" Margin="0,8,0,0"
                             MinHeight="48" TextWrapping="Wrap" AcceptsReturn="True" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal">
                <Button Content="新建像素宠物" Click="CreatePixelPet_Click"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="导入 / 领养" Click="Import_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="选用" Click="Select_Click" Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButtonStyle}" MinWidth="78" />
                <Button x:Name="LibraryMoreButton" Content="管理" Click="LibraryMoreButton_Click"
                        Margin="0,0,8,0" MinWidth="78">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="保存名称与描述" Click="SaveMetadata_Click" />
                            <MenuItem Header="校验宠物包" Click="Validate_Click" />
                            <MenuItem Header="导出分享包" Click="Export_Click" />
                            <Separator />
                            <MenuItem Header="删除所选宠物" Click="Delete_Click"
                                      Foreground="{StaticResource DangerBrush}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Content="关闭" Click="Close_Click" MinWidth="78" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
