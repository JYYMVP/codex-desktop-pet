<Window x:Class="CodexDesktopPet.PetShareLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="从公网链接领养" Width="520" Height="220" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="粘贴 GitHub Gist 宠物分享链接" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,7,0,12" TextWrapping="Wrap"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="只接受 gist.github.com 链接；下载后仍会执行宠物包路径、尺寸与透明背景校验。" />
        <TextBox x:Name="ShareUrlBox" Grid.Row="2" Padding="9,7"
                 VerticalAlignment="Top" ToolTip="https://gist.github.com/用户名/分享ID" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="领养" Click="Adopt_Click" Padding="16,7" Margin="0,0,8,0"
                    Style="{StaticResource PrimaryButtonStyle}" />
            <Button Content="取消" Click="Cancel_Click" Padding="16,7" />
        </StackPanel>
    </Grid>
</Window>
